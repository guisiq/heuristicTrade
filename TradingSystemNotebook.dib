# Genetic Programming for Stock Trading Strategies in C#

This notebook demonstrates the structure and placeholder workflow of a Genetic Programming (GP) system designed to evolve stock trading strategies. It will attempt to load live financial data for demonstration, but includes a fallback to sample data if live fetching is unsuccessful. Due to limitations in the current environment (e.g., inability to add specific NuGet packages like HeuristicLab), the actual GP algorithm execution is simulated. However, all C# classes for data handling, simulation, and the GP problem/runner structure are defined and used to show the conceptual flow.

---

#!csharp

// Core Class Definitions (Part 1 - Data Structures & Basic Strategy)
// These are foundational classes from the GeneticTradingSystem project.

using System;
using System.Collections.Generic;
using System.Globalization;
using System.Linq; // Added for Take() and Select() in later cells
using System.Net.Http; // Added for HttpClient
using System.Threading.Tasks; // Added for Task

/// <summary>
/// Represents a single Open, High, Low, Close (OHLC) data point for a financial instrument.
/// </summary>
public class OHLCDataPoint
{
    public DateTime Date { get; set; }
    public double Open { get; set; }
    public double High { get; set; }
    public double Low { get; set; }
    public double Close { get; set; }
    public double Volume { get; set; }

    public OHLCDataPoint(DateTime date, double open, double high, double low, double close, double volume)
    {
        Date = date;
        Open = open;
        High = high;
        Low = low;
        Close = close;
        Volume = volume;
    }
}

/// <summary>
/// Defines the possible trading actions.
/// </summary>
public enum TradingAction
{
    Buy, Sell, Hold
}

/// <summary>
/// Provides methods to evaluate the output of a Genetic Programming (GP) trading strategy.
/// </summary>
public static class StrategyEvaluator
{
    public static TradingAction GetActionFromProgramOutput(double outputValue)
    {
        if (outputValue > 0.5) return TradingAction.Buy;
        if (outputValue < -0.5) return TradingAction.Sell;
        return TradingAction.Hold;
    }
}

/// <summary>
/// Represents performance metrics of a trading strategy.
/// </summary>
public class PortfolioMetrics
{
    public double TotalReturn { get; }
    public double SharpeRatio { get; }
    public int TotalTrades { get; }
    public List<double> PortfolioValueOverTime { get; }

    public PortfolioMetrics(double totalReturn, double sharpeRatio, int totalTrades, List<double> portfolioValueOverTime)
    {
        TotalReturn = totalReturn;
        SharpeRatio = sharpeRatio;
        TotalTrades = totalTrades;
        PortfolioValueOverTime = portfolioValueOverTime ?? new List<double>();
    }
}

Console.WriteLine("Core classes (Part 1: OHLCDataPoint, TradingAction, StrategyEvaluator, PortfolioMetrics) defined.");

#!csharp

// Core Class Definitions (Part 2 - Simulation & Data Service Stub)

/// <summary>
/// Simulates a trading strategy over historical financial data.
/// </summary>
public class TradingSimulator
{
    public List<OHLCDataPoint> HistoricalData { get; private set; }
    public double InitialCapital { get; private set; }
    public double CommissionPerTrade { get; private set; }
    public double SlippagePercent { get; private set; }

    public TradingSimulator(List<OHLCDataPoint> historicalData, double initialCapital, double commissionPerTrade = 0, double slippagePercent = 0)
    {
        if (historicalData == null) throw new ArgumentNullException(nameof(historicalData));
        if (!historicalData.Any()) throw new ArgumentException("Historical data cannot be empty.", nameof(historicalData));
        if (initialCapital <= 0) throw new ArgumentException("Initial capital must be positive.", nameof(initialCapital));

        HistoricalData = historicalData;
        InitialCapital = initialCapital;
        CommissionPerTrade = commissionPerTrade;
        SlippagePercent = slippagePercent;
    }

    public PortfolioMetrics EvaluateStrategy(Func<OHLCDataPoint, List<double>, int, TradingAction> strategyLogic, List<double> allClosePrices)
    {
        double currentCapital = InitialCapital;
        double sharesHeld = 0;
        var portfolioValueOverTime = new List<double> { InitialCapital };
        int totalTrades = 0;

        for (int currentIndex = 0; currentIndex < HistoricalData.Count; currentIndex++)
        {
            OHLCDataPoint currentBar = HistoricalData[currentIndex];
            TradingAction action = strategyLogic(currentBar, allClosePrices, currentIndex);

            if (action == TradingAction.Buy && sharesHeld == 0 && currentCapital > 0)
            {
                double buyPrice = currentBar.Close * (1 + SlippagePercent);
                 if ((currentCapital - CommissionPerTrade) <= 0) 
                 {
                    portfolioValueOverTime.Add(currentCapital + (sharesHeld * currentBar.Close));
                    continue;
                 }
                double sharesToBuy = (currentCapital - CommissionPerTrade) / buyPrice;
                if (sharesToBuy <= 0)
                {
                    portfolioValueOverTime.Add(currentCapital + (sharesHeld * currentBar.Close));
                    continue;
                }
                sharesHeld = sharesToBuy;
                currentCapital -= (sharesToBuy * buyPrice) + CommissionPerTrade;
                totalTrades++;
            }
            else if (action == TradingAction.Sell && sharesHeld > 0)
            {
                double sellPrice = currentBar.Close * (1 - SlippagePercent);
                currentCapital += (sharesHeld * sellPrice) - CommissionPerTrade;
                sharesHeld = 0;
                totalTrades++;
            }
            double currentPortfolioValue = currentCapital + (sharesHeld * currentBar.Close);
            portfolioValueOverTime.Add(currentPortfolioValue);
        }

        double finalPortfolioValue = portfolioValueOverTime.LastOrDefault();
        if (!portfolioValueOverTime.Any()) finalPortfolioValue = InitialCapital;
        
        double totalReturn = (InitialCapital == 0) ? 0 : (finalPortfolioValue / InitialCapital) - 1;
        double sharpeRatio = 0;

        if (portfolioValueOverTime.Count >= 2)
        {
            var dailyReturns = new List<double>();
            for (int i = 1; i < portfolioValueOverTime.Count; i++)
            {
                if (portfolioValueOverTime[i-1] == 0) dailyReturns.Add(0);
                else dailyReturns.Add((portfolioValueOverTime[i] / portfolioValueOverTime[i-1]) - 1);
            }
            if (dailyReturns.Any())
            {
                double averageDailyReturn = dailyReturns.Average();
                double stdDevDailyReturn = CalculateStandardDeviation(dailyReturns);
                sharpeRatio = (stdDevDailyReturn == 0) ? 0 : (averageDailyReturn / stdDevDailyReturn) * Math.Sqrt(252);
            }
        }
        return new PortfolioMetrics(totalReturn, sharpeRatio, totalTrades, portfolioValueOverTime);
    }

    private static double CalculateStandardDeviation(List<double> values)
    {
        if (values == null || values.Count < 2) return 0;
        double mean = values.Average();
        double sumOfSquares = values.Sum(val => (val - mean) * (val - mean));
        return Math.Sqrt(sumOfSquares / (values.Count - 1));
    }
}

// NotebookDataHelper is kept for parsing sample data if live fetch fails.
public static class NotebookDataHelper {
    public static List<OHLCDataPoint> LoadDataFromCsvString(string csvString) {
        var data = new List<OHLCDataPoint>();
        var lines = csvString.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
        bool headerSkipped = false;
        foreach (var line in lines) {
            if (!headerSkipped) { headerSkipped = true; continue; }
            var parts = line.Split(',');
            if (parts.Length == 6) { // Sample data has 6 columns
                try {
                    data.Add(new OHLCDataPoint(
                        DateTime.Parse(parts[0].Trim(), System.Globalization.CultureInfo.InvariantCulture),
                        double.Parse(parts[1].Trim(), System.Globalization.CultureInfo.InvariantCulture),
                        double.Parse(parts[2].Trim(), System.Globalization.CultureInfo.InvariantCulture),
                        double.Parse(parts[3].Trim(), System.Globalization.CultureInfo.InvariantCulture),
                        double.Parse(parts[4].Trim(), System.Globalization.CultureInfo.InvariantCulture),
                        double.Parse(parts[5].Trim(), System.Globalization.CultureInfo.InvariantCulture)
                    ));
                } catch (Exception ex) {
                    Console.WriteLine($"Skipping sample data line due to parsing error: {line} - Error: {ex.Message}");
                }
            } else {
                 Console.WriteLine($"Skipping sample data line due to incorrect number of columns: {line}");
            }
        }
        return data;
    }
}

Console.WriteLine("Core classes (Part 2: TradingSimulator, NotebookDataHelper) defined.");

